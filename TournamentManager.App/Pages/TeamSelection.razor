@page "/team-selection"
@using TournamentManager.Core.Models
@using TournamentManager.Core.Services
@using System.Linq

@inject TournamentState State
@inject NavigationManager Navigation

<div class="selection-container no-print">
    <!-- 💡 現在選択中の大会名を表示 -->
    <h2>@(State.CurrentTournament?.Name ?? "大会未選択") のチーム選択</h2>

    <div class="gender-selector" style="margin-bottom: 20px;">
        <button @onclick='() => SwitchGender("Men")' class='btn @(State.CurrentGender == "Men" ? "btn-primary" : "btn-outline-primary")' style="margin-right: 10px;">男子 登録管理</button>
        <button @onclick='() => SwitchGender("Women")' class='btn @(State.CurrentGender == "Women" ? "btn-primary" : "btn-outline-primary")'>女子 登録管理</button>
    </div>

    <!-- 💡 ファイル管理パネル（不要であれば削除してください。残す場合はStateのファイル保存ロジックと連携させます） -->
    <div class="file-io-panel" style="margin: 15px 0; padding: 15px; background: #f5f5f5; border-radius: 6px; border: 1px solid #ddd;">
        <p style="margin: 0; font-size: 14px; color: #666;">※大会ごとの選択状態は自動的にファイル（tournament_storage.json）に保存されています。</p>
    </div>

    <div class="summary-box" style="background: #e9ecef; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
        <p style="margin: 0;">現在の選択状況: <strong>@GetSelectedCount()</strong> チームが選択されています。</p>
        @if (GetSelectedCount() > 99)
        {
            <p class="error-text" style="color: red; margin: 5px 0 0 0; font-weight: bold;">※最大99チームを超えています。調整してください。</p>
        }
        else if (GetSelectedCount() > 0)
        {
            <p class="success-text" style="color: green; margin: 5px 0 0 0; font-weight: bold;">（トーナメント総枠数: @CalculateTotalSlots(GetSelectedCount()) 枠）</p>
        }
    </div>

    <!-- 💡 マスターデータの表示ループ -->
    @if (masterTeamsArray != null && masterTeamsArray.Length > 0)
    {
        <div class="area-groups">
            @foreach (var areaGroup in masterTeamsArray.GroupBy(t => t.Area))
            {
                <div class="area-card" style="border: 1px solid #ddd; padding: 15px; border-radius: 6px; margin-bottom: 15px; background: #fff;">
                    <h3 style="margin-top: 0; font-size: 18px; border-bottom: 1px solid #eee; padding-bottom: 5px;">@areaGroup.Key 地区 (@areaGroup.Count() チーム)</h3>
                    <div class="team-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px;">
                        @foreach (var team in areaGroup)
                        {
                            <label class="team-checkbox-label" @key="team.Id" style="display: flex; align-items: center; gap: 8px; cursor: pointer; padding: 5px; border-radius: 4px; background: #f8f9fa;">
                                <input type="checkbox"
                                       checked="@IsTeamSelected(team.Id)"
                                       @onchange="(e) => ToggleTeamSelection(team.Id, e.Value)" />
                                <span class="team-name-span">@team.Name</span>
                            </label>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>マスターデータを読み込み中...</p>
    }

    <div class="action-bar" style="margin-top: 20px; text-align: right;">
        <button class="btn-confirm" @onclick="ConfirmEntries" disabled="@(GetSelectedCount() < 2 || GetSelectedCount() > 99)" style="padding: 10px 20px; background: #28a745; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">
            このチーム数で確定して抽選会へ
        </button>
    </div>
</div>

@code {
}
