@page "/lottery-draw"
@using TournamentManager.Core.Models
@using TournamentManager.Core.Services
@using System.Text.Json
@inject TournamentState State
@inject NavigationManager Nav
@inject IJSRuntime JS

<!-- 💡 画面全体を囲うメインコンテナ（サイドバーの外側には干渉させない） -->
<div class="lottery-page-container">

    <!-- 🛠️ 操作パネル（印刷時はこのブロックごと非表示） -->
    <div class="control-panel no-print">
        <h2>@State.CurrentTournament?.Name の抽選会・組合せ入力設定</h2>

        <!-- 🗂️ 「男子」「女子」切り替えタブ -->
        <ul class="nav nav-tabs custom-lottery-tabs">
            <li class="nav-item">
                <button class="nav-link men-tab @(activeGender == "Men" ? "active" : "")"
                        @onclick='() => ChangeGenderTabAsync("Men")'>
                    🙋‍♂️ 男子の抽選
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link women-tab @(activeGender == "Women" ? "active" : "")"
                        @onclick='() => ChangeGenderTabAsync("Women")'>
                    👩‍🦰 女子の抽選
                </button>
            </li>
        </ul>

        <div class="save-status-badge">
            <span class="status-dot"></span>
            抽選データは IndexedDB に自動保存されています
        </div>

        <p class="description-text">確定した @totalSlotsCount チームを枠番号に割り当てます。</p>

        <div class="lottery-layout">
            <!-- 未抽選のチーム一覧 -->
            <div class="unassigned-box">
                <h4 class="box-title">未抽選のチーム一覧 (@unassignedTeamsCount)</h4>
                <div class="unassigned-list">
                    @if (unassignedTeamsArray != null)
                    {
                        @foreach (var team in unassignedTeamsArray)
                        {
                            if (team.Gender == "Women")
                            {
                                <div class="team-token">
                                    <span class="area-women-badge">@team.AreaName</span>@team.Name
                                </div>
                            }
                            else
                            {
                                <div class="team-token">
                                    <span class="area-men-badge">@team.AreaName</span>@team.Name
                                </div>
                            }
                        }
                    }
                </div>
            </div>

            <!-- クジ番号の入力フォーム -->
            <div class="assignment-form">
                <h4 class="box-title">クジ番号の入力 (@(activeGender == "Men" ? "男子" : "女子"))</h4>

                <div class="input-group">
                    <label>チームを選択:</label>
                    <select @bind="selectedTeamIdForDraw">
                        <option value="">-- チームを選択 --</option>
                        @if (unassignedTeamsArray != null)
                        {
                            @foreach (var team in unassignedTeamsArray)
                            {
                                <option value="@team.Id">[@team.AreaName] @team.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="input-group">
                    <label>引いた枠番号 (1～@totalSlotsCount):</label>
                    <input type="number" @bind="inputSlotNumber" min="1" max="@totalSlotsCount" />
                </div>

                <button class="btn-assign-action" @onclick="AssignTeamToSlotAsync" disabled="@(string.IsNullOrEmpty(selectedTeamIdForDraw) || inputSlotNumber <= 0)">
                    割り当てを確定
                </button>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="error-msg">@errorMessage</p>
                }
            </div>
        </div>

        <!-- アクションボタン群 -->
        <div class="action-row">
            <div class="left-actions">
                <button class="btn-reset-data" @onclick="ClearAllAssignmentsAsync">
                    @(activeGender == "Men" ? "男子" : "女子")の抽選をリセット
                </button>
                <button class="btn-print-trigger" onclick="window.print()">
                    この状態でBracketを印刷
                </button>
            </div>
            <button class="btn-back-nav" @onclick='() => Nav.NavigateTo("/team-selection")'>
                ← チーム選択に戻る
            </button>
        </div>
    </div>

    <!-- 🖨️ 印刷用ヘッダー（通常時はCSSにより非表示、印刷時のみ出現） -->
    <div class="print-only">
        <h2 class="print-title">@State.CurrentTournament?.Name トーナメント表 (@(activeGender == "Men" ? "男子" : "女子"))</h2>
    </div>

    <!-- 📊 トーナメント表描画エリア（svg幅が外枠を壊さないよう100%に追従） -->
    <div class="bracket-display-area">
        <svg width="100%" height="100%" viewBox="0 0 1400 1200" xmlns="http://w3.org" preserveAspectRatio="xMidYMid meet">
            <style>
                .match-line {
                    stroke: #111111;
                    stroke-width: 2;
                    fill: none;
                }

                .match-line_debug1 {
                    stroke: #006400;
                    stroke-width: 2;
                    fill: none;
                }

                .match-line_debug2 {
                    stroke: #0000ff;
                    stroke-width: 2;
                    fill: none;
                }

                .match-line_debug3 {
                    stroke: #ff1493;
                    stroke-width: 2;
                    fill: none;
                }

                .match-line_debug4 {
                    stroke: #d2691e;
                    stroke-width: 2;
                    fill: none;
                }
            </style>
            @if (engine?.Matches != null)
            {
                @foreach (var match in engine.Matches)
                {
@*
                    <line x1="@match.LineStartXA" y1="@match.ParentAY" x2="@match.X" y2="@match.ParentAY" class="match-line" />
                    <line x1="@match.LineStartXB" y1="@match.ParentBY" x2="@match.X" y2="@match.ParentBY" class="match-line" />
                    <line x1="@match.X" y1="@match.ParentAY" x2="@match.X" y2="@match.ParentBY" class="match-line" />
                    <line x1="@match.X" y1="@match.Y" x2="@(match.X + 160)" y2="@match.Y" class="match-line" />
 *@
                    <line x1="@match.LineStartXA" y1="@match.ParentAY" x2="@match.X" y2="@match.ParentAY" class="match-line_debug1" />
                    <line x1="@match.LineStartXB" y1="@match.ParentBY" x2="@match.X" y2="@match.ParentBY" class="match-line_debug2" />
                    <line x1="@match.X" y1="@match.ParentAY" x2="@match.X" y2="@match.ParentBY" class="match-line_debug3" />
                    <!--
                        このラインは、勝ち上がりのライン？
                    <line x1="@match.X" y1="@match.Y" x2="@(match.X + 160)" y2="@match.Y" class="match-line_debug4" />
                    -->
                }
            }
            @if (engine?.SvgTexts != null)
            {
                @foreach (var txt in engine.SvgTexts)
                {
                    <SvgText X="@txt.X" Y="@txt.Y" CssClass="@txt.CssClass">@txt.Content</SvgText>
                }
            }
        </svg>
    </div>
</div>
