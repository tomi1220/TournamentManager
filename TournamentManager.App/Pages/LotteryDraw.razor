@page "/lottery-draw"
@using TournamentManager.Core.Models
@using TournamentManager.Core.Services
@using System.Text.Json
@inject TournamentState State
@inject NavigationManager Nav

<div class="lottery-wrapper">
    <div class="control-panel no-print">
        <h2>@State.CurrentTournament?.Name の抽選会・組合せ入力設定 (@(State.CurrentGender == "Men" ? "男子" : "女子"))</h2>

        <div class="save-status-badge">
            <span class="status-dot"></span> 抽選データは自動保存されています（tournament_storage.json）
        </div>

        <div class="file-io-panel" style="margin: 15px 0; padding: 15px; background: #f5f5f5; border-radius: 6px; border: 1px solid #ddd;">
            <p style="margin: 0; font-size: 14px; color: #666;">※別PCへのデータ移行が必要な場合は、サーバー内のJSONファイルをコピーしてください。</p>
        </div>

        <p>確定した @totalSlotsCount チームを枠番号に割り当てます。</p>

        <div class="lottery-layout">
            <div class="unassigned-box">
                <h4>未抽選のチーム一覧 (@unassignedTeamsCount)</h4>
                <div class="unassigned-list">
                    @if (unassignedTeamsArray != null)
                    {
                        @foreach (var team in unassignedTeamsArray)
                        {
                            <div class="team-token" style="padding: 5px; margin-bottom: 5px; background: #e9ecef; border-radius: 4px;">
                                <span class="area-badge" style="background: #6c757d; color: white; padding: 2px 6px; border-radius: 3px; font-size: 12px; margin-right: 5px;">@team.Area</span> @team.Name
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="assignment-form">
                <h4>クジ番号の入力</h4>
                <div class="input-group" style="margin-bottom: 10px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 5px;">チームを選択:</label>
                    <select @bind="selectedTeamIdForDraw" style="width: 100%; padding: 6px; border-radius: 4px; border: 1px solid #ccc;">
                        <option value="">-- チームを選択 --</option>
                        @if (unassignedTeamsArray != null)
                        {
                            @foreach (var team in unassignedTeamsArray)
                            {
                                <option value="@team.Id">[@team.Area] @team.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="input-group" style="margin-bottom: 15px;">
                    <label style="display: block; font-weight: bold; margin-bottom: 5px;">引いた枠番号 (1～@totalSlotsCount):</label>
                    <input type="number" @bind="inputSlotNumber" min="1" max="@totalSlotsCount" style="width: 100%; padding: 6px; border-radius: 4px; border: 1px solid #ccc;" />
                </div>
                <button class="btn-assign" @onclick="AssignTeamToSlot" disabled="@(string.IsNullOrEmpty(selectedTeamIdForDraw) || inputSlotNumber <= 0)" style="width: 100%; padding: 8px; background: #28a745; color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">
                    割り当てを確定
                </button>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="error-msg" style="color: red; font-weight: bold; margin-top: 10px;">@errorMessage</p>
                }
            </div>
        </div>

        <div class="action-row" style="margin-top: 20px; display: flex; gap: 10px;">
            <button class="btn-secondary" @onclick="ClearAllAssignments" style="padding: 8px 15px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;">抽選データを一括リセット</button>
            <button class="btn-print" onclick="window.print()" style="padding: 8px 15px; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;">この状態でBracketを印刷</button>
            <button class="btn-back" @onclick='() => Nav.NavigateTo("/team-selection")' style="padding: 8px 15px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">← チーム選択に戻る</button>
        </div>
    </div>

    <!-- トーナメント表描画エリア -->
    <div class="bracket-display-area" style="margin-top: 30px; border: 1px solid #ddd; padding: 20px; background: #fff;">
        <svg width="1400" height="1200" viewBox="0 0 1400 1200" xmlns="http://w3.org">
            <style>
                .match-line {
                    stroke: #111111;
                    stroke-width: 2;
                    fill: none;
                }
            </style>
            @if (engine?.Matches != null)
            {
                @foreach (var match in engine.Matches)
                {
                    <line x1="@match.LineStartXA" y1="@match.ParentAY" x2="@match.X" y2="@match.ParentAY" class="match-line" />
                    <line x1="@match.LineStartXB" y1="@match.ParentBY" x2="@match.X" y2="@match.ParentBY" class="match-line" />
                    <line x1="@match.X" y1="@match.ParentAY" x2="@match.X" y2="@match.ParentBY" class="match-line" />
                    <line x1="@match.X" y1="@match.Y" x2="@(match.X + 160)" y2="@match.Y" class="match-line" />
                }
            }
            @if (engine?.SvgTexts != null)
            {
                @foreach (var txt in engine.SvgTexts)
                {
                    <SvgText X="@txt.X" Y="@txt.Y" CssClass="@txt.CssClass">@txt.Content</SvgText>
                }
            }
        </svg>
    </div>
</div>

